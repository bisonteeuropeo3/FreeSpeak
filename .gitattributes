# Line endings matter here: build-mac.sh runs on macOS, where a CRLF shebang
# fails with "bad interpreter".
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.rs text eol=lf

# Already-compressed, and rewritten by the build: keep them byte-exact.
*.exe binary
*.ico binary
*.png binary
*.icns binary
